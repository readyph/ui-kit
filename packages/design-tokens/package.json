{
  "name": "@readyph/design-tokens",
  "version": "0.1.0",
  "description": "ReadyPH design tokens, Tailwind preset and CSS-variable theme.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/readyph/ui-kit.git",
    "directory": "packages/design-tokens"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": "./preset.cjs",
    "./theme.css": "./css/theme.css"
  },
  "files": [
    "dist",
    "css",
    "preset.cjs"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "prebuild": "npm run generate",
    "build": "tsup",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
